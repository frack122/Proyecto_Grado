@model IEnumerable<Prueba1.Modelo.Materia>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Home/Index.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombremateria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.creditos)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombremateria)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.creditos)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Codigomateria">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Codigomateria">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Codigomateria">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
